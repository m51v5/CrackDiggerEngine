<Window x:Class="CrackDigger.Sample.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CrackDigger.Sample.ViewModels"
        xmlns:local="clr-namespace:CrackDigger.Sample"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
        Title="About CrackDigger Sample" Icon="/Assets/app.ico"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource DarkWindow}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close"/>
    </Window.InputBindings>

    <Border BorderBrush="{StaticResource Surface2}" BorderThickness="1">
        <StackPanel MouseLeftButtonDown="Drag_Window" Background="Transparent">
            <!-- Gradient strip, same colors as the main window -->
            <Border Height="6" Background="{StaticResource BrandGradientHorizontal}"/>

            <Button HorizontalAlignment="Right" Style="{StaticResource CloseButton}" Width="40" Height="32"
                    ToolTip="Close" AutomationProperties.Name="Close" Command="ApplicationCommands.Close">
                <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="12"/>
            </Button>

            <StackPanel Margin="24 0 24 20">
                <!-- Identity -->
                <Image Source="/Assets/app.png" Width="72" Height="72"/>
                <TextBlock Text="CrackDigger Sample" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0 12 0 0"/>
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0 2 0 0"/>
                <TextBlock Text="Searches game sites with CrackDiggerEngine." TextWrapping="Wrap" TextAlignment="Center" Margin="0 12 0 0"/>

                <TextBlock Text="PROJECT" Style="{StaticResource SectionTitle}" Margin="4 18 0 6"/>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Button Style="{StaticResource AboutRow}" Command="{Binding OpenCommand}"
                                CommandParameter="{x:Static local:AppLinks.Releases}" ToolTip="{x:Static local:AppLinks.Releases}">
                            <TextBlock Text="What's new"/>
                        </Button>
                        <Button Style="{StaticResource AboutRow}" Command="{Binding CheckUpdateCommand}" ToolTip="{Binding Update.ToolTip}">
                            <DockPanel>
                                <TextBlock Text="{Binding Update.Text}" Style="{StaticResource RowValue}"/>
                                <TextBlock Text="Check for updates"/>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource AboutRow}" Command="{Binding OpenCommand}"
                                CommandParameter="{x:Static local:AppLinks.Repository}" ToolTip="{x:Static local:AppLinks.Repository}">
                            <TextBlock Text="Source code"/>
                        </Button>
                        <Button Style="{StaticResource AboutRow}" Command="{Binding OpenCommand}"
                                CommandParameter="{x:Static local:AppLinks.Security}" ToolTip="{x:Static local:AppLinks.Security}">
                            <TextBlock Text="Privacy"/>
                        </Button>
                        <Button Style="{StaticResource AboutRow}" Command="{Binding OpenCommand}"
                                CommandParameter="{x:Static local:AppLinks.License}" ToolTip="{x:Static local:AppLinks.License}">
                            <DockPanel>
                                <TextBlock Text="MIT" Style="{StaticResource RowValue}"/>
                                <TextBlock Text="License"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Text="HELP" Style="{StaticResource SectionTitle}" Margin="4 18 0 6"/>
                <Border Style="{StaticResource CardPanel}">
                    <Button Style="{StaticResource AboutRow}" Command="{Binding OpenCommand}"
                            CommandParameter="{x:Static local:AppLinks.ReportProblem}" ToolTip="{x:Static local:AppLinks.ReportProblem}">
                        <TextBlock Text="Report a problem"/>
                    </Button>
                </Border>

                <TextBlock Text="MADE BY" Style="{StaticResource SectionTitle}" Margin="4 18 0 6"/>
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Button Style="{StaticResource AboutRow}" Command="{Binding OpenCommand}"
                                CommandParameter="{x:Static local:AppLinks.Website}" ToolTip="{x:Static local:AppLinks.Website}">
                            <DockPanel>
                                <TextBlock Text="@m51v5" Style="{StaticResource RowValue}"/>
                                <TextBlock Text="Mustafa Jassem"/>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource AboutRow}" Command="{Binding OpenCommand}"
                                CommandParameter="{x:Static local:AppLinks.Telegram}" ToolTip="{x:Static local:AppLinks.Telegram}">
                            <DockPanel>
                                <TextBlock Text="@m51v5" Style="{StaticResource RowValue}"/>
                                <TextBlock Text="Telegram"/>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource AboutRow}" Command="{Binding OpenCommand}"
                                CommandParameter="{x:Static local:AppLinks.Contact}" ToolTip="{x:Static local:AppLinks.Contact}">
                            <TextBlock Text="Other platforms"/>
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Text="© 2025 @m51v5. MIT License." Style="{StaticResource Muted}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0 20 0 0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
