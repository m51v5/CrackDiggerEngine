<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CrackDigger.Sample</RootNamespace>
    <Product>CrackDigger Sample</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <IsPackable>false</IsPackable>
    <!-- Lets CI build this WPF project on Linux -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CrackDiggerEngine\CrackDiggerEngine.csproj" />
  </ItemGroup>

</Project>
