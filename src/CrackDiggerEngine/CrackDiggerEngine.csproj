<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CrackDigger</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CrackDiggerEngine</PackageId>
    <Version>2.0.0</Version>
    <Authors>@m51v5</Authors>
    <Description>Search game listings on several public game sites and get the title, link and image of each result.</Description>
    <Copyright>Copyright (c) 2025 @m51v5</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/m51v5/CrackDiggerEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/m51v5/CrackDiggerEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageTags>game-search;scraping;html-parser;data-extraction</PackageTags>
    <PackageReleaseNotes>https://github.com/m51v5/CrackDiggerEngine/releases</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Keeps local folder paths out of the built DLL -->
  <PropertyGroup>
    <PathMap>$(MSBuildProjectDirectory)=/_/src/CrackDiggerEngine</PathMap>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.jpg" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
